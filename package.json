{
  "name": "motion",
  "module": "src/main.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/server.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "guard:client": "bun run scripts/guard-client-bundle.ts",
    "verify": "bun run typecheck && bun run guard:client && bun run test && bun run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.9.6",
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev18.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tiptap/extension-code-block-lowlight": "^3.16.0",
    "@tiptap/extension-table": "3.16.0",
    "@tiptap/pm": "^3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "@types/marked": "^6.0.0",
    "@types/turndown": "^5.0.6",
    "apache-arrow": "^21.1.0",
    "dompurify": "^3.4.12",
    "lowlight": "^3.3.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "turndown": "^7.2.2"
  }
