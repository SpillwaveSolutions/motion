{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions plus the window controls an overlay title bar needs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
